{
  "extends": "@stll/typescript-config/library.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noImplicitAny": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tsdown.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
