{
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.87.0 <2",
    "oxlint-tsgolint": ">=7.0.2003 <8"
  },
  "target": {
    "type": "javascript",
    "targets": [
      "node20.19.0"
    ]
  },
  "entryPoints": {
    "type": "module",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        },
        "default": "./dist/index.mjs"
      },
      "./plugin": {
        "import": {
          "types": "./dist/plugin.d.mts",
          "default": "./dist/plugin.mjs"
        },
        "require": {
          "types": "./dist/plugin.d.cts",
          "default": "./dist/plugin.cjs"
        },
        "default": "./dist/plugin.mjs"
      },
      "./no-raw-colors": {
        "import": {
          "types": "./dist/no-raw-colors.d.mts",
          "default": "./dist/no-raw-colors.mjs"
        },
        "require": {
          "types": "./dist/no-raw-colors.d.cts",
          "default": "./dist/no-raw-colors.cjs"
        },
        "default": "./dist/no-raw-colors.mjs"
      },
      "./toolchain.json": "./toolchain.json"
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "bin": {
      "stll-cloud-setup": "./dist/cloud-setup-cli.mjs",
      "stll-toolchain-check": "./dist/toolchain-check-cli.mjs",
      "stll-typecheck-parity": "./dist/typecheck-parity-cli.mjs",
      "stll-publish-contract": "./dist/publish-contract-cli.mjs",
      "stll-consumer-compat": "./dist/consumer-compat-cli.mjs"
    }
  }
}
