{
  "name": "@stll/oxlint-config",
  "version": "3.5.0",
  "description": "Shared general oxlint configuration for stella packages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella/tooling.git",
    "directory": "packages/oxlint-config"
  },
  "bin": {
    "stll-cloud-setup": "./dist/cloud-setup-cli.mjs",
    "stll-consumer-compat": "./dist/consumer-compat-cli.mjs",
    "stll-dependabot": "./dist/dependabot-cli.mjs",
    "stll-engine-support": "./dist/engine-support-cli.mjs",
    "stll-publish-contract": "./dist/publish-contract-cli.mjs",
    "stll-quarantine": "./dist/quarantine-cli.mjs",
    "stll-rust-policy": "./dist/rust-policy-cli.mjs",
    "stll-toolchain-changed": "./dist/toolchain-changed-cli.mjs",
    "stll-toolchain-check": "./dist/toolchain-check-cli.mjs",
    "stll-typecheck-probe": "./dist/typecheck-probe-cli.mjs",
    "stll-normalize-wasi-loaders": "./dist/wasi-loader-normalizer-cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "toolchain.json"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      },
      "default": "./dist/plugin.mjs"
    },
    "./no-raw-colors": {
      "import": {
        "types": "./dist/no-raw-colors.d.mts",
        "default": "./dist/no-raw-colors.mjs"
      },
      "require": {
        "types": "./dist/no-raw-colors.d.cts",
        "default": "./dist/no-raw-colors.cjs"
      },
      "default": "./dist/no-raw-colors.mjs"
    },
    "./toolchain.json": "./toolchain.json",
    "./build-target": {
      "import": {
        "types": "./dist/publish-build-target-nuxt-helper.d.mts",
        "default": "./dist/publish-build-target-nuxt-helper.mjs"
      },
      "require": {
        "types": "./dist/publish-build-target-nuxt-helper.d.cts",
        "default": "./dist/publish-build-target-nuxt-helper.cjs"
      },
      "default": "./dist/publish-build-target-nuxt-helper.mjs"
    },
    "./declaration-only-dts": {
      "import": {
        "types": "./dist/publish-build-target-vite-dts-helper.d.mts",
        "default": "./dist/publish-build-target-vite-dts-helper.mjs"
      },
      "require": {
        "types": "./dist/publish-build-target-vite-dts-helper.d.cts",
        "default": "./dist/publish-build-target-vite-dts-helper.cjs"
      },
      "default": "./dist/publish-build-target-vite-dts-helper.mjs"
    },
    "./dependabot": {
      "import": {
        "types": "./dist/dependabot.d.mts",
        "default": "./dist/dependabot.mjs"
      },
      "require": {
        "types": "./dist/dependabot.d.cts",
        "default": "./dist/dependabot.cjs"
      },
      "default": "./dist/dependabot.mjs"
    },
    "./engine-support": {
      "import": {
        "types": "./dist/engine-support.d.mts",
        "default": "./dist/engine-support.mjs"
      },
      "require": {
        "types": "./dist/engine-support.d.cts",
        "default": "./dist/engine-support.cjs"
      },
      "default": "./dist/engine-support.mjs"
    },
    "./quarantine": {
      "import": {
        "types": "./dist/quarantine-policy.d.mts",
        "default": "./dist/quarantine-policy.mjs"
      },
      "require": {
        "types": "./dist/quarantine-policy.d.cts",
        "default": "./dist/quarantine-policy.cjs"
      },
      "default": "./dist/quarantine-policy.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@changesets/assemble-release-plan": "7.0.0",
    "@changesets/config": "4.0.1",
    "@changesets/read": "1.0.1",
    "@manypkg/get-packages": "3.1.0",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "picomatch": "4.0.7",
    "semver": "7.8.5",
    "smol-toml": "1.9.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "oxlint": "1.89.0",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.5",
    "vite-plugin-dts": "5.1.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.89.0 <2",
    "oxlint-tsgolint": ">=7.0.2005 <8",
    "vite": "8.3.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
