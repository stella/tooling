{
  "name": "@stll/oxlint-config",
  "version": "0.4.0",
  "description": "Shared general oxlint configuration for stella packages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella/tooling.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      },
      "default": "./dist/plugin.mjs"
    },
    "./no-raw-colors": {
      "import": {
        "types": "./dist/no-raw-colors.d.mts",
        "default": "./dist/no-raw-colors.mjs"
      },
      "require": {
        "types": "./dist/no-raw-colors.d.cts",
        "default": "./dist/no-raw-colors.cjs"
      },
      "default": "./dist/no-raw-colors.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "oxfmt": "0.48.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.75.0 <2",
    "oxlint-tsgolint": ">=7.0.2001 <8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
