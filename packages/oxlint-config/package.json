{
  "name": "@stll/oxlint-config",
  "version": "0.12.2",
  "description": "Shared general oxlint configuration for stella packages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella/tooling.git",
    "directory": "packages/oxlint-config"
  },
  "bin": {
    "stll-cloud-setup": "./dist/cloud-setup-cli.mjs",
    "stll-consumer-compat": "./dist/consumer-compat-cli.mjs",
    "stll-publish-contract": "./dist/publish-contract-cli.mjs",
    "stll-toolchain-check": "./dist/toolchain-check-cli.mjs",
    "stll-typecheck-parity": "./dist/typecheck-parity-cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "toolchain.json"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.mts",
        "default": "./dist/plugin.mjs"
      },
      "require": {
        "types": "./dist/plugin.d.cts",
        "default": "./dist/plugin.cjs"
      },
      "default": "./dist/plugin.mjs"
    },
    "./no-raw-colors": {
      "import": {
        "types": "./dist/no-raw-colors.d.mts",
        "default": "./dist/no-raw-colors.mjs"
      },
      "require": {
        "types": "./dist/no-raw-colors.d.cts",
        "default": "./dist/no-raw-colors.cjs"
      },
      "default": "./dist/no-raw-colors.mjs"
    },
    "./toolchain.json": "./toolchain.json",
    "./build-target": {
      "import": {
        "types": "./dist/publish-build-target-nuxt-helper.d.mts",
        "default": "./dist/publish-build-target-nuxt-helper.mjs"
      },
      "require": {
        "types": "./dist/publish-build-target-nuxt-helper.d.cts",
        "default": "./dist/publish-build-target-nuxt-helper.cjs"
      },
      "default": "./dist/publish-build-target-nuxt-helper.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "bun check",
    "test": "bun test",
    "format": "oxfmt ."
  },
  "dependencies": {
    "picomatch": "4.0.5",
    "semver": "7.8.5",
    "smol-toml": "1.9.0",
    "tsx": "4.23.13",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@stll/typescript-config": "workspace:*",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.87.0 <2",
    "oxlint-tsgolint": ">=7.0.2003 <8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
