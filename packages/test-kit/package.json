{
  "name": "@stll/test-kit",
  "version": "0.4.0",
  "description": "Hermetic, deterministic test primitives for Bun: controlled time and randomness, local HTTP, isolated files, bounded waits, and a network guard.",
  "keywords": [
    "bun",
    "clock",
    "deterministic",
    "test",
    "testing"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stella/tooling.git",
    "directory": "packages/test-kit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/forbid-network.mjs"
  ],
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./db": {
      "types": "./dist/db-clock.d.mts",
      "default": "./dist/db-clock.mjs"
    },
    "./forbid-network": {
      "types": "./dist/forbid-network.d.mts",
      "default": "./dist/forbid-network.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "bun check --no-pretty --all --project=tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@stll/time": "0.4.2",
    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@stll/typescript-config": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "peerDependencies": {
    "drizzle-orm": ">=1.0.0-rc.4 <2"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
