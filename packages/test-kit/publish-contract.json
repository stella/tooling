{
  "engines": {},
  "peerDependencies": {
    "drizzle-orm": ">=1.0.0-rc.4 <2"
  },
  "target": {
    "type": "javascript",
    "targets": ["esnext"]
  },
  "entryPoints": {
    "type": "module",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./db": {
        "types": "./dist/db-clock.d.mts",
        "default": "./dist/db-clock.mjs"
      },
      "./forbid-network": {
        "types": "./dist/forbid-network.d.mts",
        "default": "./dist/forbid-network.mjs"
      }
    },
    "main": "dist/index.mjs",
    "types": "dist/index.d.mts"
  }
}
